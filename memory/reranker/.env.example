# ===== reranker 服务自身配置 =====
# 监听地址（0.0.0.0 允许其他机器访问）
RERANKER_HOST=0.0.0.0
RERANKER_PORT=8866

# 模型（与主程序 STOCK_MEMORY_RERANKER_MODEL 对应）
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 若已离线下好模型目录，填这里可零网络加载（优先于 RERANKER_MODEL）
RERANKER_LOCAL_DIR=

# 推理设备：cpu / cuda
RERANKER_DEVICE=cpu

# 单条候选文档最大截断长度（字符）
RERANKER_MAX_DOC_LEN=1024

# 空闲卸载：0=常驻（独立机器推荐）；>0=空闲多少秒后卸载权重省内存
RERANKER_IDLE_TTL=0
