{
  "meta": {
    "name": "KDJ超买超卖",
    "description": "KDJ指标K值低于超卖线买入（超卖反弹），高于超买线卖出（超买回落）。K线灵敏，配合J线可辅助判断拐点。",
    "tags": ["反转", "KDJ", "入门"],
    "source": "template",
    "strategy_id": "kdj_reversal",
    "category": "reversal"
  },
  "params": {
    "n": { "value": 9, "min": 5, "max": 30, "step": 1, "label": "KDJ周期", "type": "int" },
    "oversold": { "value": 20, "min": 5, "max": 30, "step": 1, "label": "超卖线", "type": "int" },
    "overbought": { "value": 80, "min": 70, "max": 95, "step": 1, "label": "超买线", "type": "int" }
  },
  "conditions": {
    "buy": {
      "logic": "AND",
      "rules": [
        {
          "type": "indicator",
          "left": { "func": "kdj", "args": ["high", "low", "close", "{n}"], "field": "k" },
          "op": "<",
          "right": { "value": "{oversold}" }
        }
      ]
    },
    "sell": {
      "logic": "AND",
      "rules": [
        {
          "type": "indicator",
          "left": { "func": "kdj", "args": ["high", "low", "close", "{n}"], "field": "k" },
          "op": ">",
          "right": { "value": "{overbought}" }
        }
      ]
    }
  },
  "risk": {
    "stop_loss": { "type": "fixed", "value": 0.05 },
    "take_profit": { "type": "fixed", "value": 0.10 }
  },
  "chart_indicators": [
    { "type": "KDJ", "period": "{n}" }
  ]
}
