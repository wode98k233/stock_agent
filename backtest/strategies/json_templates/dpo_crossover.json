{
  "meta": {
    "name": "DPO金叉死叉",
    "description": "DPO上穿MADPO买入（底部金叉），下穿MADPO卖出（顶部死叉）。区间震荡线剥离了长期趋势，只保留短期偏离，对拐点反应通常比MACD、KDJ更早，适合捕捉洗盘结束后的第一买点。",
    "tags": ["震荡", "DPO", "反转", "拐点"],
    "source": "template",
    "strategy_id": "dpo_crossover",
    "category": "oscillator"
  },
  "params": {
    "period": { "value": 20, "min": 10, "max": 60, "step": 1, "label": "DPO周期", "type": "int", "unit": "日" },
    "smooth": { "value": 6, "min": 3, "max": 30, "step": 1, "label": "MADPO平滑", "type": "int", "unit": "日" }
  },
  "conditions": {
    "buy": {
      "logic": "AND",
      "rules": [
        {
          "type": "indicator",
          "left": { "func": "dpo", "args": ["close", "{period}", "{smooth}"], "field": "dpo" },
          "op": "cross_above",
          "right": { "func": "dpo", "args": ["close", "{period}", "{smooth}"], "field": "madpo" }
        }
      ]
    },
    "sell": {
      "logic": "AND",
      "rules": [
        {
          "type": "indicator",
          "left": { "func": "dpo", "args": ["close", "{period}", "{smooth}"], "field": "dpo" },
          "op": "cross_below",
          "right": { "func": "dpo", "args": ["close", "{period}", "{smooth}"], "field": "madpo" }
        }
      ]
    }
  },
  "risk": {
    "stop_loss": { "type": "fixed", "value": 0.05 },
    "take_profit": { "type": "fixed", "value": 0.12 }
  },
  "chart_indicators": [
    { "type": "DPO", "period": "{period}", "smooth": "{smooth}" }
  ]
}
