{
  "meta": {
    "name": "DPO多空与超买超卖",
    "description": "基于DPO的0轴多空与超买超卖参考线：DPO>0为多头、<0为空头；在0轴上方设超买线、下方设超卖线。当DPO从超卖区回升（>超卖线且仍<0）买入，从超买区回落（<超买线且仍>0）卖出。注意：超买/超卖线为绝对价位，随个股价格尺度不同需自行调整。",
    "tags": ["震荡", "DPO", "超买超卖", "0轴"],
    "source": "template",
    "strategy_id": "dpo_oscillator",
    "category": "oscillator"
  },
  "params": {
    "period": { "value": 20, "min": 10, "max": 60, "step": 1, "label": "DPO周期", "type": "int", "unit": "日" },
    "smooth": { "value": 6, "min": 3, "max": 30, "step": 1, "label": "MADPO平滑", "type": "int", "unit": "日" },
    "overbought": { "value": 2.0, "min": 0.5, "max": 20.0, "step": 0.1, "label": "超买线", "type": "float" },
    "oversold": { "value": -2.0, "min": -20.0, "max": -0.5, "step": 0.1, "label": "超卖线", "type": "float" }
  },
  "conditions": {
    "buy": {
      "logic": "AND",
      "rules": [
        {
          "type": "indicator",
          "left": { "func": "dpo", "args": ["close", "{period}", "{smooth}"], "field": "dpo" },
          "op": ">",
          "right": { "value": "{oversold}" }
        },
        {
          "type": "indicator",
          "left": { "func": "dpo", "args": ["close", "{period}", "{smooth}"], "field": "dpo" },
          "op": "<",
          "right": { "value": 0 }
        }
      ]
    },
    "sell": {
      "logic": "AND",
      "rules": [
        {
          "type": "indicator",
          "left": { "func": "dpo", "args": ["close", "{period}", "{smooth}"], "field": "dpo" },
          "op": "<",
          "right": { "value": "{overbought}" }
        },
        {
          "type": "indicator",
          "left": { "func": "dpo", "args": ["close", "{period}", "{smooth}"], "field": "dpo" },
          "op": ">",
          "right": { "value": 0 }
        }
      ]
    }
  },
  "risk": {
    "stop_loss": { "type": "fixed", "value": 0.05 },
    "take_profit": { "type": "fixed", "value": 0.10 }
  },
  "chart_indicators": [
    { "type": "DPO", "period": "{period}", "smooth": "{smooth}" }
  ]
}
