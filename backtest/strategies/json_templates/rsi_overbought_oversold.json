{
  "meta": {
    "name": "RSI超买超卖",
    "description": "RSI指标低于超卖线买入（超卖反弹），高于超买线卖出（超买回落）。基于均值回归原理，适合震荡市。",
    "tags": [
      "反转",
      "RSI",
      "入门"
    ],
    "source": "template",
    "strategy_id": "rsi_overbought_oversold",
    "category": "reversal"
  },
  "params": {
    "rsi_period": {
      "value": 14,
      "min": 2,
      "max": 50,
      "step": 1,
      "label": "RSI周期",
      "type": "int",
      "help": "RSI 计算周期。越小越灵敏。",
      "recommended": [
        10,
        20
      ]
    },
    "oversold": {
      "value": 30,
      "min": 10,
      "max": 40,
      "step": 1,
      "label": "超卖线",
      "type": "int",
      "help": "超卖线：RSI 低于此视为超卖。",
      "recommended": [
        20,
        35
      ]
    },
    "overbought": {
      "value": 70,
      "min": 60,
      "max": 90,
      "step": 1,
      "label": "超买线",
      "type": "int",
      "help": "超买线：RSI 高于此视为超买。",
      "recommended": [
        65,
        80
      ]
    }
  },
  "conditions": {
    "buy": {
      "logic": "AND",
      "rules": [
        {
          "type": "indicator",
          "left": {
            "func": "rsi",
            "args": [
              "close",
              "{rsi_period}"
            ]
          },
          "op": "<",
          "right": {
            "value": "{oversold}"
          }
        }
      ]
    },
    "sell": {
      "logic": "AND",
      "rules": [
        {
          "type": "indicator",
          "left": {
            "func": "rsi",
            "args": [
              "close",
              "{rsi_period}"
            ]
          },
          "op": ">",
          "right": {
            "value": "{overbought}"
          }
        }
      ]
    }
  },
  "risk": {
    "stop_loss": {
      "type": "fixed",
      "value": 0.06
    },
    "take_profit": {
      "type": "fixed",
      "value": 0.12
    }
  },
  "chart_indicators": [
    {
      "type": "RSI",
      "period": "{rsi_period}"
    }
  ]
}
