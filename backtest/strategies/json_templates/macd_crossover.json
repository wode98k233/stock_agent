{
  "meta": {
    "name": "MACD金叉死叉",
    "description": "MACD线（DIF）上穿信号线（DEA）买入，下穿卖出。经典趋势跟踪策略，对中长线趋势反应灵敏。",
    "tags": ["趋势", "MACD", "入门"],
    "source": "template",
    "strategy_id": "macd_crossover",
    "category": "trend"
  },
  "params": {
    "fast": { "value": 12, "min": 5, "max": 30, "step": 1, "label": "快线EMA", "type": "int" },
    "slow": { "value": 26, "min": 15, "max": 50, "step": 1, "label": "慢线EMA", "type": "int" },
    "signal": { "value": 9, "min": 5, "max": 20, "step": 1, "label": "信号线", "type": "int" }
  },
  "conditions": {
    "buy": {
      "logic": "AND",
      "rules": [
        {
          "type": "indicator",
          "left": { "func": "macd", "args": ["close", "{fast}", "{slow}", "{signal}"], "field": "macd" },
          "op": "cross_above",
          "right": { "func": "macd", "args": ["close", "{fast}", "{slow}", "{signal}"], "field": "signal" }
        }
      ]
    },
    "sell": {
      "logic": "AND",
      "rules": [
        {
          "type": "indicator",
          "left": { "func": "macd", "args": ["close", "{fast}", "{slow}", "{signal}"], "field": "macd" },
          "op": "cross_below",
          "right": { "func": "macd", "args": ["close", "{fast}", "{slow}", "{signal}"], "field": "signal" }
        }
      ]
    }
  },
  "risk": {
    "stop_loss": { "type": "fixed", "value": 0.05 },
    "take_profit": { "type": "fixed", "value": 0.15 }
  },
  "chart_indicators": [
    { "type": "MACD", "fast": "{fast}", "slow": "{slow}", "signal": "{signal}" }
  ]
}
