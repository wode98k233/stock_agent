# 选股雷达 配置文件示例
# 复制此文件为 .env 并填写你的配置

# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o

# LLM 高级配置（JSON格式）
OPENAI_HEADERS=
OPENAI_DEFAULT_PARAMS={"max_tokens": 16384}
# reasoning_content 回传策略：auto / always / never
OPENAI_REASONING_CONTENT_POLICY=auto
# 思考模式强度: low/medium/high/none（none=关闭思考），留空=不发送参数（老模型兼容）
OPENAI_REASONING_EFFORT=medium
# 额外请求体 (JSON)，会合并到每次 LLM 请求的 body 中
EXTRA_BODY={"thinking": {"type": "disabled"}}

# LLM 缓存前缀 (Prompt Caching)
# 启用后在 LLM 调用前注入固定前缀，利用 API 的 prompt caching 降低费用
# DeepSeek 自动缓存 (90% 折扣), OpenAI 自动缓存 (50% 折扣)
CACHE_PREFIX_ENABLED=false
# 自定义前缀内容 (留空使用默认 A 股知识前缀)
CACHE_PREFIX_CONTENT=

# ============================================================
# LLM 语义缓存 + 模型路由 (A8，默认关闭灰度，配置面板可开)
# ============================================================

# --- 语义缓存：命中同义同场景问题直接返回缓存响应，跳过 LLM 调用 ---
LLM_CACHE_ENABLED=false
# TTL 分级映射(秒，0=禁缓存)：market=市场观点(30min)；sector_intraday=盘中板块(禁缓存)；
# sector_offhours=盘后板块(4h)；methodology=方法论(7d)；data_query=数据查询(禁缓存)
LLM_CACHE_TTL_MAP={"market":1800,"sector_intraday":0,"sector_offhours":14400,"methodology":604800,"data_query":0}
# 场景→缓存类别映射（未列出场景默认 sector）
LLM_CACHE_CATEGORY_MAP={"market_quick":"market","market_overview":"market","sector_analysis":"sector","stock_analysis":"sector","methodology":"methodology","data_query":"data_query","default":"sector"}

# --- 模型路由：按场景/标签路由到 fast/standard/strong 三档模型 ---
LLM_ROUTING_ENABLED=false
# 路由映射表(JSON，按顺序首条命中生效，default 为兜底档位)；热改配置生效
LLM_ROUTING_MAP={"rules":[{"match":{"scenario":["market_quick","data_query"]},"tier":"fast"},{"match":{"label":["report_enhance","deep_research","debate"]},"tier":"strong"},{"match":{"purpose":["compress","judge"]},"tier":"fast"}],"default":"standard"}
# 各档模型名（留空=沿用该用途原配模型；仅换模型名，凭证沿用原配置）
LLM_TIER_FAST_MODEL=
LLM_TIER_STANDARD_MODEL=
LLM_TIER_STRONG_MODEL=

# 东方财富妙想Skills 配置
MX_APIKEY=your_mx_apikey_here

# 同花顺问财 Skills 配置
IWENCAI_API_KEY=your_iwencai_api_key_here
IWENCAI_BASE_URL=https://openapi.iwencai.com

TUSHARE_TOKEN=your_tushare_token_here

# --- 同花顺官方金融数据服务 (https://fuyao.aicubes.cn/admin/ 签发) ---
HITHINK_FINANCE_API_KEY=                        # 必填，空则数据源自动禁用
HITHINK_PRIORITY=95                             # 数据源优先级（默认 95，Sina 100 与 Akshare 90 之间）

# ============================================================
# 通知层配置 (Notification Layer)
# ============================================================

# --- 全局开关 ---
NOTIFICATION_ENABLED=false                    # 启用通知层
NOTIFICATION_CHANNELS=                        # 指定渠道，逗号分隔 (留空=全部)
NOTIFICATION_DEFAULT_FORMAT=markdown          # 默认消息格式: markdown / text

# --- 去重 / 降噪 ---
NOTIFICATION_DEDUP_TTL=300                    # 去重窗口(秒)
NOTIFICATION_COOLDOWN=60                      # 最小发送间隔(秒)
NOTIFICATION_QUIET_START=23                   # 静默开始(小时)
NOTIFICATION_QUIET_END=7                      # 静默结束(小时)

# --- 钉钉 (DingTalk) ---
DINGTALK_WEBHOOK_URL=                         # Webhook URL
DINGTALK_WEBHOOK_SECRET=                      # 签名密钥 (可选)

# --- 飞书 (Feishu) ---
FEISHU_WEBHOOK_URL=                           # Webhook URL
FEISHU_WEBHOOK_SECRET=                        # 签名密钥 (可选)
FEISHU_WEBHOOK_KEYWORD=                       # 关键词前缀 (可选)

# --- 企业微信 (WeChat Work) ---
WECHAT_WEBHOOK_URL=                           # Webhook URL

# --- Telegram ---
TELEGRAM_BOT_TOKEN=                           # Bot Token
TELEGRAM_CHAT_ID=                             # Chat ID

# --- Email (SMTP) ---
EMAIL_SMTP_HOST=                              # SMTP 服务器 (留空自动检测)
EMAIL_SMTP_PORT=465                           # 端口
EMAIL_SMTP_USER=                              # 用户名
EMAIL_SMTP_PASSWORD=                          # 密码
EMAIL_RECIPIENTS=                             # 收件人，逗号分隔

# --- 通用 Webhook ---
CUSTOM_WEBHOOK_URL=                           # 自定义 URL
CUSTOM_WEBHOOK_METHOD=POST                    # HTTP 方法
CUSTOM_WEBHOOK_HEADERS=                       # 自定义 Headers (JSON)

# --- Discord ---
DISCORD_WEBHOOK_URL=                          # Webhook URL

# --- Slack ---
SLACK_WEBHOOK_URL=                            # Webhook URL

# --- Pushover ---
PUSHOVER_USER_KEY=                            # User Key
PUSHOVER_APP_TOKEN=                           # App Token

# --- ntfy ---
NTFY_URL=https://ntfy.sh                      # ntfy 服务器地址
NTFY_TOPIC=                                   # 订阅主题

# --- Gotify ---
GOTIFY_URL=                                   # Gotify 服务器地址
GOTIFY_TOKEN=                                 # App Token

# --- PushPlus ---
PUSHPLUS_TOKEN=                               # Token

# --- Server酱3 ---
SERVERCHAN3_SENDKEY=                          # SendKey

# 搜索引擎配置（逗号分隔多个 Key，无 Key 时自动降级到 MX 搜索）
SERPAPI_API_KEYS=
TAVILY_API_KEYS=
BOCHA_API_KEYS=
BRAVE_API_KEYS=
ANSPIRE_API_KEYS=
MINIMAX_API_KEYS=
# SearXNG 自建实例地址（多个用逗号分隔）
SEARXNG_URLS=
# 是否使用 SearXNG 公共实例（无配额限制；国内网络拉不到实例清单，实测不可用，需自建）
SEARXNG_PUBLIC_INSTANCES=false
# 是否启用免 Key 境外搜索源（Parallel / Exa 托管 MCP，免配置、国内可达，作兜底）
# false = 关闭，通用网搜不会把查询发往境外服务
SEARCH_FREE_MCP_ENABLED=true

# Longbridge 配置（港美股数据源，需注册获取 Key）
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# Finnhub 配置（美股数据源，免费 tier 60 次/分）
FINNHUB_API_KEY=

# ========== 数据源优先级（数字越大越优先，默认值见代码） ==========
# MX_PRIORITY=110
# SINA_PRIORITY=100
# AKSHARE_PRIORITY=90
# EFINANCE_PRIORITY=80
# BAOSTOCK_PRIORITY=70
# TUSHARE_PRIORITY=60
# QQ_PRIORITY=50
# YFINANCE_PRIORITY=45
# FINNHUB_PRIORITY=48
# LONGBRIDGE_PRIORITY=35
# AKSHARE_CALL_TIMEOUT=30

# Akshare 反爬：请求间隔随机区间（秒）+ 实时行情缓存 TTL（秒）
AKSHARE_RATE_LIMIT_MIN=2.0
AKSHARE_RATE_LIMIT_MAX=5.0
AKSHARE_REALTIME_CACHE_TTL=1200
# Pytdx（通达信协议数据源）
PYTDX_PRIORITY=75
PYTDX_CONNECTION_COOLDOWN=15
PYTDX_SERVERS=

# ========== Agent 通用配置 ==========
# 对话记忆开关（ConversationSummaryBufferMemory）
MEMORY_ENABLED=true
# 批量分析股票时，每次处理的数量
BATCH_SIZE=5
# 记忆压缩的最大Token数
MEMORY_MAX_TOKENS=8000
# 信息累积压缩阈值（主要用于多步执行状态/观察信息）
INFO_ACCUMULATOR_COMPRESS_THRESHOLD=6000
# 澄清反问（Web）：开工前信息不足时先问（默认开）
CLARIFY_ENABLED=true
# 澄清问题数量上限
CLARIFY_MAX_QUESTIONS=5
# 澄清等待超时（秒）：到点没人作答则按推荐选项继续分析
CLARIFY_TIMEOUT_SECONDS=300

# ========== ReAct 模式 ==========
# 工具调用上限（LangGraph recursion_limit，每个 LLM + 工具调用各算 1 步）
REACT_TOOL_CALLS=25
# 一次装载候选池前 N 个技能的工具+L1（<=0 全量；=1 即旧的单 active 行为）
REACT_SKILL_BATCH_SIZE=5
# 每 N 轮工具后回 router 重新组批（中途换批；<=0 关闭）
REACT_SKILL_RESELECT_EVERY=1
# 是否启用上下文压缩
REACT_ENABLE_CONTEXT_COMPACTION=true
# 最近保留的完整 ReAct 轮次
# 0=纯滑动窗口模式（推荐，可避免Agent循环）
# 1+=保留最近N轮完整上下文（可能增加循环风险）
REACT_CONTEXT_RECENT_ROUNDS=1
# 触发历史摘要的最小旧轮次数
REACT_SUMMARY_TRIGGER_ROUNDS=4
# 触发历史摘要的累计字符阈值
REACT_SUMMARY_PENDING_CHARS=15000
# 历史摘要最大字符数
REACT_SUMMARY_MAX_CHARS=5000
# 跨轮工具结果复用模式：exact=精确复用+MX数据槽位复用，off=关闭
REACT_DEDUP_MODE=exact
# 是否输出上下文压缩调试日志
REACT_CONTEXT_DEBUG_LOG=true

# ========== Plan / PDOR / Unified 模式 ==========
# 规划步数上限（Plan 与 PDOR 使用）
PLAN_MAX_STEPS=5
# Executor单步重试次数
PLAN_EXECUTOR_MAX_RETRIES=3
# Executor内部ReAct工具调用上限（Plan/Unified 的子 ReAct 使用）
# 建议 6-10，避免预算过快耗尽
PLAN_EXECUTOR_TOOL_CALLS=8

# ========== 预算控制 ==========
# Token上限
MAX_TOKENS_PER_QUERY=500000
# LLM调用次数上限
MAX_LLM_CALLS_PER_QUERY=80
# 时间上限（秒）
MAX_TIME_SECONDS=1800
# 豁免窗口：预算超限后用户选择继续时，短期内跳过 budget check
# 豁免调用次数上限（每次 LLM check 消耗1次，一轮 agent-tool 约5-8次）
BUDGET_EXEMPT_CALLS_LIMIT=10
# 豁免时间窗口（秒）
BUDGET_EXEMPT_TIME_LIMIT=120

# ========== Checkpoint 快照配置 ==========
# 快照后端：memory（内存，默认）/ sqlite（持久化）/ pg（PostgreSQL）
CHECKPOINT_BACKEND=memory
# PostgreSQL 连接串（仅 pg 模式需要）
CHECKPOINT_PG_URI=

# ========== 缓存配置 ==========
# 通用缓存过期时间（小时）
CACHE_EXPIRE_HOURS=24
# 各类缓存独立过期时间（小时）
CACHE_STOCK_HISTORY_HOURS=24
CACHE_BOARD_HOURS=24
CACHE_NEWS_HOURS=2
CACHE_RATING_HOURS=72
CACHE_FINANCIAL_HOURS=48

# ========== 分析框架引擎 ==========
# 启用分析框架后处理（true/false）
REPORT_ENABLE_ANALYSIS_ENGINE=true
# 默认报告模板（lightweight/standard/professional）
REPORT_TEMPLATE=standard
# 模板续问判定模式：keyword(基于历史的规则续问,默认零成本) / llm(调用 LLM 判定续问并选模板)
REPORT_TEMPLATE_CONTINUATION_MODE=keyword
# 默认时间框架（short/mid/long）
REPORT_TIME_HORIZON=short
# 报告合成模式（fast=快速模式1次LLM调用）
REPORT_MODE=fast
# 报告最低输出 Token，低于该值会触发一次扩写；0=禁用篇幅保护
REPORT_MIN_TOKENS=2500
# 报告技术面图板数量上限：板块分析涉及多只个股时每只各出一张图板，0=不注入
REPORT_TECH_PANEL_MAX=3
# 工具输出截断阈值（字符数）
REPORT_MAX_TOOL_OUTPUT_CHARS=3000
# 新闻文本截断阈值（字符数）
REPORT_MAX_NEWS_CHARS=3000
# 报告合成专用模型（留空则使用 OPENAI_MODEL_NAME）
REPORT_LLM_MODEL=
# 报告合成专用 API 配置（留空则使用基础配置）
REPORT_LLM_API_KEY=
REPORT_LLM_API_BASE=
# 报告证据下钻（索引→按序号选择→只载入选中工具全文；默认开启，聚焦注意力）：
# 开启后报告生成多一次小调用（report-select），失败/证据过小时自动退回全量
REPORT_DRILLDOWN_ENABLED=true
# 触发下钻的最小工具调用数（与字符数阈值满足其一即触发）
REPORT_DRILLDOWN_MIN_TOOLS=8
# 触发下钻的最小证据字符数（工具输出合计，与条数阈值满足其一即触发）
REPORT_DRILLDOWN_MIN_CHARS=12000
# 工具输出压缩模型（留空则使用基础模型）
COMPRESS_LLM_MODEL=
# 压缩模型专用 API 配置（留空则使用基础配置）
COMPRESS_LLM_API_KEY=
COMPRESS_LLM_API_BASE=
# 评测 Judge 模型（建议配置与 Agent 不同的第三方模型，避免同模型自评失真）
JUDGE_LLM_MODEL=
JUDGE_LLM_API_KEY=
JUDGE_LLM_API_BASE=

# ========== LLM 网关（utils.llm） ==========
# 统一网关收口 chat / embedding / rerank 调用，统一施加限流 / 降级 / 熔断 / 重试 / 计量。
# 默认直接复用上方 OPENAI_* / REPORT_LLM_* / COMPRESS_LLM_* / JUDGE_LLM_* 等配置，
# 无需额外配置即可工作；新代码建议改用 `from utils.llm import gateway`（详见 utils/llm/__init__.py 用法）。
# 可选：用一份 yaml/json 覆盖默认模型与降级链（格式见 docs/superpowers/specs/2026-07-12-llm-gateway-design.md）。
# 留空则尝试加载 utils/llm/ 同目录下的 models.yaml（不存在则仅用 env 配置）。
LLM_GATEWAY_MODELS_PATH=
# 网关默认 chat 重试次数（主模型失败后、降级前的瞬时错误重试；0=不重试，留空用默认 2）
LLM_GATEWAY_CHAT_RETRIES=
# 熔断器：连续失败达到该次数后开闸（不再重试该模型，直接降级）；留空用默认 5
LLM_GATEWAY_BREAKER_THRESHOLD=
# 熔断器：开闸后冷却时长（秒），冷却结束进入半开探测；留空用默认 30
LLM_GATEWAY_BREAKER_COOLDOWN=

# 工具输出压缩阈值（字符数，0=禁用压缩）
TOOL_OUTPUT_COMPRESS_THRESHOLD=2000
# per-tool 压缩阈值（JSON 格式，优先级高于 TOOL_OUTPUT_COMPRESS_THRESHOLD，留空则使用上方全局值）
TOOL_COMPRESS_THRESHOLDS={"default":2000,"mx_search_news":2000}
# 工具输出硬截断上限（字符数，压缩后仍超长时直接截断，0=禁用）
TOOL_HARD_TRUNCATE_CHARS=8000
# 工具输出规则压缩总开关（默认关闭，灰度后按工具放量）
TOOL_RULE_COMPRESS_ENABLED=false
# 规则压缩模式（JSON，off=不启用 / shadow=双算落盘不改输出 / on=采用规则输出后按阈值决定是否再走 LLM）
# 已覆盖工具：mx_xuangu_filter / mx_search_news / mx_data_query / iwc_market_query / iwc_sector_selector /
#   iwc_announcement_search / get_positions / get_hot_stocks / get_limit_up_pool /
#   get_limit_break_pool / get_etf_history / get_lianban_ladder
# 示例：先全量影子观察；稳定后把对应工具改 on
TOOL_RULE_COMPRESS_POLICY={"default":"off","mx_xuangu_filter":"shadow","mx_search_news":"shadow"}

# ========== 日志/调试 ==========
LOG_LEVEL=DEBUG
# 在 DEBUG 级别下，每个 step 执行前需要手动确认
DEBUG_STEP_CONFIRM=false
ENABLE_TRACE=true
# Trace 数据库路径（留空使用默认）
TRACE_DB_PATH=

# 开发模式：每次请求前热重载 Agent 模块（代码修改即时生效，无需重启 Web）
# 生产环境请关闭，会增加请求延迟
WEB_DEV_RELOAD=false
# 侧边栏显示「日志关联」溯源工具按钮（回答溯源·执行归因面板），默认隐藏（开发者功能）
WEB_SHOW_TRACE_TOOLS=false
# LLM 自动生成会话标题：首轮提问由 classify 顺带生成标题回填（仅生成一次，成功后不覆盖；
# 失败则后续轮次仍以首轮提问为依据补生成）。关闭后沿用提问截断标题
WEB_DIALOG_AUTO_TITLE=true

# ========== Web 服务 ==========
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Web 进程 event loop 默认线程池上限。
# asyncio 默认按 min(32, 核数+4) 开线程（20 核机 = 24），导致 web 进程线程数虚高。
# 该池被 warmup / kline 拉取 / 记忆接口 / 通知等共享，限制为 8 即可（IO 密集，会排队但不阻塞）。
WEB_MAX_WORKERS=8

# ========== 系统 ==========
# 系统监控采集间隔（秒）
MONITOR_INTERVAL=2
# 数据源最大失败次数（超过后跳过该数据源）
DATASOURCE_MAX_FAILS=5
# 数据源优先级自定义顺序（逗号分隔的源名，如 hithink,akshare,mx_data）；
# 留空=用各源内置 priority。可在「系统配置 → 数据 → 数据源优先级」里拖拽调整（保存后立即生效）。
DATASOURCE_PRIORITY_ORDER=
# 东财防封补丁
AKSHARE_ENABLE_EASTMONEY_PATCH=true

# ========== 盯盘告警 ==========
# 盯盘总开关（默认关闭；开启后交易时段自动轮询自选股并按规则推送告警）
MARKET_MONITOR_ENABLED=false
# 盯盘轮询间隔（秒）
MARKET_MONITOR_INTERVAL_S=60

# ========== 市场情绪面板（右栏） ==========
# 面板总开关（右栏温度计+异动快报；关闭后前端显示"已关闭"且不再拉取上游）
MARKET_DASHBOARD_ENABLED=true
# 前端轮询间隔（秒；异动为快层，情绪仍按服务端 60s 缓存）
MARKET_DASHBOARD_REFRESH_S=10
# 异动快报条数上限
MARKET_DASHBOARD_ALERT_LIMIT=30
# 新闻 Tab 条数上限
MARKET_DASHBOARD_NEWS_LIMIT=20

# ========== 全局总览大屏（研究分析 → 全局总览） ==========
# 总开关；关闭后 API 返回占位、前端不拉取数据
OVERVIEW_ENABLED=true
# 研究类块（宏观/台账/质量/评测等）聚合结果缓存秒数
OVERVIEW_BLOCK_CACHE_TTL_S=60
# 行情类块（大盘/短线/持仓/自选）静默刷新间隔秒数，0=关闭
OVERVIEW_MARKET_REFRESH_S=60
# 运行状态块前端轮询间隔秒数
OVERVIEW_RUNTIME_REFRESH_S=10
# 策略扫描结果缓存秒数
OVERVIEW_SCAN_TTL_S=600
# 策略扫描 K 线回溯根数
OVERVIEW_SCAN_DAYS=120
# 策略白名单（逗号分隔策略 ID；留空=全部）
OVERVIEW_SCAN_STRATEGIES=
# 扫描前补尾预算（秒）：必须远小于扫描块软超时 90s，否则会「块已超时但仍在跑」
OVERVIEW_SCAN_REFRESH_BUDGET_S=20
# 扫描前补尾上限（码；0=关闭）；只对落后于最近已完成交易日的标的补 K 线缺口
OVERVIEW_SCAN_REFRESH_MAX=6
# 宏观指标白名单（逗号分隔指标码；留空=默认 12 项）
OVERVIEW_MACRO_INDICATORS=
# 自选行情取数预算秒数（超时降级用缓存行情，避免顶爆区块 20s 软超时）
OVERVIEW_WATCHLIST_BUDGET_S=8
# Agent 使用统计：token 趋势窗口天数
OVERVIEW_TOKEN_DAYS=14
# 成本估算标注模型名（仅展示口径，不参与计算）
OVERVIEW_TOKEN_MODEL=DeepSeek v4.1 Flash
# 成本估算单价（元 / 百万 token）——默认按 DeepSeek v4.1 Flash，按实际账单手工填写
OVERVIEW_TOKEN_PRICE_IN=2.0
OVERVIEW_TOKEN_PRICE_OUT=8.0
OVERVIEW_TOKEN_PRICE_CACHED=0.2

# ========== 持仓账本 ==========
# 持仓上下文注入 agent（命中持仓关键词且有持仓时注入 [用户持仓账本]；关闭即回到现状）
PORTFOLIO_ENRICH_ENABLED=true

# 决策仪表盘
DASHBOARD_ENABLED=true
DASHBOARD_LLM_ENABLED=true
DASHBOARD_MAX_LLM_TOKENS=2000

# Agent 群模式
GROUP_MAX_CONCURRENT_AGENTS=3
GROUP_AGENT_MAX_RETRIES=3
GROUP_MAX_REPLAN_COUNT=3
GROUP_MAX_STEPS=10
GROUP_MAX_LLM_CALLS=100

# ========== 记忆系统 ==========
# jieba 中文分词开关（禁用可节省 ~40MB 内存，分词退化为原文匹配）
JIEBA_ENABLED=true
# 检索后端: auto / fts5 / embedding / hybrid
# auto = 有 embedding_fn 则 hybrid, 否则 fts5
STOCK_MEMORY_BACKEND=auto
# embedding 模式: 留空禁用, openai/remote / local
STOCK_MEMORY_EMBEDDING=
# 记忆系统专用 API 配置（留空则回退到基础 OPENAI_API_KEY / OPENAI_API_BASE）
STOCK_MEMORY_API_KEY=
STOCK_MEMORY_API_BASE=
# OpenAI 兼容 API embedding 模型名
STOCK_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# 本地 sentence-transformers 模型名
STOCK_MEMORY_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
# 检索最大条数（已提升：拼接 session 历史后召回更多相关记忆）
MEMORY_RETRIEVAL_TOP_K=8
# 注入 prompt 的最大字符数（已提升：避免历史记忆被截断）
MEMORY_MAX_PROMPT_TOKENS=3000
# 注入总字符预算（优先于 MEMORY_MAX_PROMPT_TOKENS；6000≈3000 token）
MEMORY_MAX_PROMPT_CHARS=6000
# 同一份报告最多注入的 chunk 数（旧硬编码为 3）
MEMORY_MAX_CHUNKS_PER_GROUP=6
# 单块展示字符上限（chunk 本身 ≤1000，一般无需再截）
MEMORY_CHUNK_MAX_CHARS=1000
# 语义相似度绝对下限（自适应门槛 floor；0 关闭）
MEMORY_MIN_SIMILARITY=0.30
# 语义相似度相对带宽（保留 top_score-margin 以内的命中；0=纯绝对门槛）
MEMORY_SIMILARITY_MARGIN=0.12
# 用户画像语义抽取（prototype 向量补充关键词表；开启后每轮可能多 1 次 embedding）
MEMORY_PROFILE_SEMANTIC=true
# 情景记忆保留天数
MEMORY_EPISODIC_RETENTION_DAYS=90
# 置信度门槛：低于此值的记忆不注入 prompt（0 关闭过滤）
MEMORY_CONFIDENCE_THRESHOLD=0.4
# 后台自动清理过期记忆的间隔（分钟），0=禁用
MEMORY_AUTO_CLEANUP_INTERVAL_MINUTES=60
# 初始化时等待 embedding 服务（如 Ollama）就绪的最长秒数（超时则降级为纯 FTS5）
STOCK_MEMORY_EMBEDDING_READY_TIMEOUT=30
# 初始化时探针轮询间隔秒数
STOCK_MEMORY_EMBEDDING_READY_INTERVAL=1.5
# Reranker（Cross-encoder 精排，可选。留空=不启用, local=本地模型, openai=远程API）
STOCK_MEMORY_RERANKER=
STOCK_MEMORY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
STOCK_MEMORY_RERANKER_LOCAL_DIR=
# Reranker 专用 API 配置（仅 openai 模式生效，留空则回退到 STOCK_MEMORY_API_KEY → OPENAI_API_KEY）
STOCK_MEMORY_RERANKER_API_KEY=
STOCK_MEMORY_RERANKER_API_BASE=
# 内存控制：本地模型加载后空闲超过该秒数自动卸载；0=每次精排后立即卸载。默认 120
STOCK_MEMORY_RERANKER_IDLE_TTL=120
# 是否启动即预热 reranker（常驻内存，首检最快）。默认 false=按需加载+空闲卸载，基线内存最低
STOCK_MEMORY_RERANKER_PRELOAD=false

# ── 后台巡检（启动后异步跑，不阻塞启动；总开关关闭即完全不起调度，需重启生效） ──
# 总开关
BACKGROUND_SCANS_ENABLED=true
# 存储监控扫描（纯本地：db/ 大小 + 行数快照）
SCAN_STORAGE_ENABLED=true
SCAN_STORAGE_FIRST_DELAY_S=45
SCAN_STORAGE_INTERVAL_MINUTES=720
# 研究台账刷新（启动后自动补当日数据并落快照，免打开页面现等）
SCAN_THESIS_ENABLED=true
SCAN_THESIS_FIRST_DELAY_S=90
SCAN_THESIS_INTERVAL_MINUTES=240
# 全市场拥挤度扫描（板块池限流 2-5s/调，建议保持日频）
SCAN_CROWDING_ENABLED=true
SCAN_CROWDING_FIRST_DELAY_S=150
SCAN_CROWDING_INTERVAL_MINUTES=1440
# 短线情绪预热（启动后拉当日四池/天梯固化快照；hithink 限频敏感，排最后错峰）
SCAN_SHORTLINE_ENABLED=true
SCAN_SHORTLINE_FIRST_DELAY_S=180
SCAN_SHORTLINE_INTERVAL_MINUTES=60
# K 线保活：把「持仓 ∪ 自选」的日线补到最近已完成交易日。
# 关掉后 K 线只在打开页面时由扫描路径兜底补（每轮仅数只、收敛很慢），
# 大屏策略信号会大面积标注「数据截止 N 天前」。
SCAN_KLINE_ENABLED=true
SCAN_KLINE_FIRST_DELAY_S=240
SCAN_KLINE_INTERVAL_MINUTES=60
# 单轮预算：超时把剩余标的顺延到下一轮，避免长占网络与限流额度
SCAN_KLINE_BUDGET_S=120
SCAN_KLINE_MAX_CODES=200
