{
  "template_id": "deep_sector_consumer",
  "variant": "consumer",
  "name": "板块深度 · 消费",
  "asset_type": "sector",
  "total_words_target": [
    10000,
    13000
  ],
  "charts_target": [
    8,
    20
  ],
  "estimate_anchors": [
    "社零同比",
    "PE分位",
    "股息率"
  ],
  "note": "消费看需求（社零/CPI/餐饮）与子板块分化；价格带与渠道库存是白酒的核心变量。",
  "slots": {
    "snapshot": {
      "desc": "指数点位/涨跌/成交/估值分位",
      "priority": 0
    },
    "valuation": {
      "desc": "PE/PB/股息率及历史分位",
      "priority": 0
    },
    "series_history": {
      "desc": "消费/白酒指数历史序列",
      "priority": 0
    },
    "macro": {
      "desc": "社零同比、CPI、10Y 国债",
      "priority": 0
    },
    "capital_flow": {
      "desc": "主力净流入、北向、两融",
      "priority": 0
    },
    "consensus_poll": {
      "desc": "近 90 天机构观点与评级",
      "priority": 1,
      "tool_hint": "iwc_search(report)"
    },
    "constituents": {
      "desc": "成分股涨跌与估值横截面",
      "priority": 0
    },
    "financials": {
      "desc": "龙头财报：营收/净利/毛利率",
      "priority": 1
    },
    "news": {
      "desc": "渠道、批价、库存相关新闻",
      "priority": 2
    },
    "industry_space": {
      "desc": "行业规模与增速（外部测算）",
      "priority": 2
    },
    "share_cr": {
      "desc": "份额与集中度",
      "priority": 2,
      "tool_hint": "研报摘要"
    }
  },
  "sections": [
    {
      "id": "summary",
      "title": "投资摘要",
      "target_words": [
        600,
        800
      ],
      "required": true,
      "data_slots": [
        "snapshot",
        "valuation"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "一句话给方向、时间框架与信号强度；列 3–5 条「判断 + 数字」；最后写最大风险。"
    },
    {
      "id": "catalog",
      "title": "目录与图表目录",
      "target_words": [
        0,
        0
      ],
      "required": true,
      "data_slots": [],
      "charts": [],
      "supply": [
        "program"
      ],
      "prompt": "由程序生成，不要手写正文。"
    },
    {
      "id": "consensus",
      "title": "与市场不同之处",
      "target_words": [
        800,
        1000
      ],
      "required": true,
      "data_slots": [
        "consensus_poll"
      ],
      "charts": [],
      "supply": [
        "report",
        "own"
      ],
      "prompt": "先写市场共识（机构 + 日期），再写我们的反证（自有数据），最后给验证条件。"
    },
    {
      "id": "overview",
      "title": "消费景气与周期定位",
      "target_words": [
        1200,
        1500
      ],
      "required": true,
      "data_slots": [
        "series_history",
        "macro"
      ],
      "charts": [],
      "supply": [
        "own",
        "report"
      ],
      "prompt": "用指数走势 + 社零/CPI 判断当前处于复苏、磨底还是过热；必须给区间与同比读数。"
    },
    {
      "id": "demand",
      "title": "需求与政策",
      "target_words": [
        1200,
        1500
      ],
      "required": true,
      "data_slots": [
        "macro",
        "news"
      ],
      "charts": [],
      "supply": [
        "report",
        "own"
      ],
      "prompt": "社零分项、餐饮收入、促消费政策；外部测算注明机构与年份，拿不到就写「外部测算缺失，仅作定性」。"
    },
    {
      "id": "subsegment",
      "title": "子板块分化",
      "target_words": [
        1200,
        1500
      ],
      "required": true,
      "data_slots": [
        "constituents",
        "valuation"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "白酒/啤酒/调味品/零食/软饮等子板块的涨跌、估值与景气对比；用同一口径横向比。"
    },
    {
      "id": "channel",
      "title": "渠道与价格体系",
      "target_words": [
        1000,
        1300
      ],
      "required": true,
      "data_slots": [
        "consensus_poll",
        "news"
      ],
      "charts": [],
      "supply": [
        "report",
        "own"
      ],
      "prompt": "批价、库存、回款与终端动销；研报口径须写机构 + 日期，无数据写「数据缺失：批价/库存」。"
    },
    {
      "id": "targets",
      "title": "龙头与弹性标的",
      "target_words": [
        1800,
        2200
      ],
      "required": true,
      "data_slots": [
        "constituents",
        "financials"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "分「确定性龙头 / 高弹性标的」两类；每个标的给一条可验证理由 + 一个关键数字。"
    },
    {
      "id": "advice",
      "title": "估值与红利",
      "target_words": [
        1200,
        1500
      ],
      "required": true,
      "data_slots": [
        "valuation",
        "macro"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "PE 分位、股息率与 10Y 国债利差、历史极值对比；不给目标价就明说「未覆盖」。"
    },
    {
      "id": "risk",
      "title": "风险提示",
      "target_words": [
        400,
        600
      ],
      "required": true,
      "data_slots": [],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "需求不及预期、批价下行、渠道库存、政策与食品安全；每条对应前文判断。"
    }
  ],
  "qa_rules": [
    "任何外部数字必须带（来源，日期）；无来源数字不得出现",
    "子板块对比必须同口径（同区间、同指标）",
    "数据缺失必须显式写「数据缺失：<字段>」，禁止用 0 或「约」代替",
    "图表必须带 source 与 asof，无源图不得出现"
  ]
}