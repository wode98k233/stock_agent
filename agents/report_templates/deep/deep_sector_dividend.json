      "data_slots": [
        "snapshot",
        "valuation"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "一句话给股息率-利差位置与配置结论；列 3–5 条「判断 + 数字」；最后写最大风险。"
    },
    {
      "id": "catalog",
      "title": "目录与图表目录",
      "target_words": [
        0,
        0
      ],
      "required": true,
      "data_slots": [],
      "charts": [],
      "supply": [
        "program"
      ],
      "prompt": "由程序生成，不要手写正文。"
    },
    {
      "id": "consensus",
