      "required": true,
      "data_slots": [
        "financials",
        "series_history"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "营收/利润/自由现金流的波动率；分红率与可持续性。"
    },
    {
      "id": "policy",
      "title": "价格与政策",
      "target_words": [
        1000,
        1300
      ],
      "required": true,
      "data_slots": [
        "news",
        "macro"
      ],
      "charts": [],
      "supply": [
        "report",
        "own"
      ],
      "prompt": "电价/水价/燃气价与监管政策；政策数字带文件与日期。"
    },
    {
      "id": "targets",
      "title": "标的：高股息与稳定",
      "target_words": [
        1600,
        2000
      ],
      "required": true,
      "data_slots": [
        "constituents",
        "financials"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "分「高股息 / 稳定成长」两类；每个标的给股息率 + 一个关键数字。"
    },
    {
      "id": "advice",
      "title": "配置建议",
      "target_words": [
        1000,
        1300
      ],
      "required": true,
      "data_slots": [
        "valuation"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "给仓位/久期/替代品比较；不给目标价就明说「未覆盖」。"
    },
    {
      "id": "risk",
      "title": "风险提示",
      "target_words": [
        400,
        600
      ],
      "required": true,
      "data_slots": [],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "利率上行、分红下调、监管价格调整、盈利下滑；每条对应前文判断。"
    }
  ],
  "qa_rules": [
    "任何外部数字必须带（来源，日期）；无来源数字不得出现",
    "数据缺失必须显式写「数据缺失：<字段>」，禁止用 0 或「约」代替",
    "图表必须带 source 与 asof，无源图不得出现",
    "股息率必须注明口径（TTM/预测）与日期"
  ]
