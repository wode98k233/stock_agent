      "required": true,
      "data_slots": [
        "financials",
        "constituents"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "完全成本、头均盈利、产能去化；同业对比同口径。"
    },
    {
      "id": "demand",
      "title": "需求与政策",
      "target_words": [
        1000,
        1300
      ],
      "required": true,
      "data_slots": [
        "news",
        "macro"
      ],
      "charts": [],
      "supply": [
        "report",
        "own"
      ],
      "prompt": "消费需求、收储/补贴政策；政策数字带文件与日期。"
    },
    {
      "id": "valuation",
      "title": "估值",
      "target_words": [
        1000,
        1300
      ],
      "required": true,
      "data_slots": [
        "valuation"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "PB 分位、头均市值；周期不同阶段口径不同需说明。"
    },
    {
      "id": "targets",
      "title": "标的：龙头与弹性",
      "target_words": [
        1600,
        2000
      ],
      "required": true,
      "data_slots": [
        "constituents",
        "financials"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "分「成本领先 / 弹性标的」两类；每个标的给一条可验证理由 + 一个关键数字。"
    },
    {
      "id": "risk",
      "title": "风险提示",
      "target_words": [
        400,
        600
      ],
      "required": true,
      "data_slots": [],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "猪价下跌、疫病、政策收储不及预期、成本上升；每条对应前文判断。"
    }
  ],
  "qa_rules": [
    "任何外部数字必须带（来源，日期）；无来源数字不得出现",
    "数据缺失必须显式写「数据缺失：<字段>」，禁止用 0 或「约」代替",
    "图表必须带 source 与 asof，无源图不得出现",
    "猪价/产能数据必须注明来源与日期"
  ]
}