      "required": true,
      "data_slots": [
        "snapshot",
        "valuation"
      ],
      "charts": [],
      "supply": [
        "own"
      ],
      "prompt": "一句话给猪周期位置（去化/上行/下行）与信号强度；列 3–5 条「判断 + 数字」；最后写最大风险。"
    },
    {
      "id": "catalog",
      "title": "目录与图表目录",
      "target_words": [
        0,
        0
      ],
      "required": true,
      "data_slots": [],
      "charts": [],
      "supply": [
        "program"
      ],
      "prompt": "由程序生成，不要手写正文。"
    },
    {
      "id": "consensus",
      "title": "与市场不同之处",
      "target_words": [
        800,
        1000
      ],
      "required": true,
      "data_slots": [
        "consensus_poll"
      ],
      "charts": [],
      "supply": [
        "report",
        "own"
      ],
      "prompt": "先写市场共识（机构 + 日期），再写我们的反证（自有数据），最后给验证条件。"
