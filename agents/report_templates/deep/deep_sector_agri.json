      "charts": [],
      "supply": [
        "own",
        "report"
      ],
      "prompt": "猪价、出栏均重、能繁母猪存栏；逐个给读数与方向，缺的写「数据缺失：<字段>」。"
    },
    {
      "id": "supply",
      "title": "供给与成本",
      "target_words": [
        1200,
        1500
