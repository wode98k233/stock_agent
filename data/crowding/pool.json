{
  "version": "1.0",
  "name": "全市场拥挤度标的池",
  "description": "指数池 + 东财行业板块池；拥挤度 = 均线延伸度 / 20 日动量 / 放量比 / 60 日追高 的加权合成。改这个文件即可调池子与阈值，不需要改代码。",
  "indices": {
    "mode": "db",
    "include": [],
    "exclude": ["399300"],
    "max": 60
  },
  "boards": {
    "enabled": true,
    "provider": "akshare",
    "board_type": "industry",
    "mode": "all",
    "include": [],
    "exclude": [],
    "max": 600,
    "collect_limit_per_run": 150
  },
  "params": {
    "ma_days": 250,
    "min_rows": 120,
    "hist_days": 400,
    "stale_days": 7,
    "top_n": 60,
    "hot_score": 75.0
  },
  "weights": {
    "ext": 0.3,
    "mom": 0.25,
    "vol": 0.25,
    "chase": 0.2
  },
  "thresholds": {
    "ext": [[-99, -5, 10], [-5, 0, 25], [0, 8, 40], [8, 18, 60], [18, 30, 78], [30, 99, 95]],
    "mom": [[-99, 0, 15], [0, 4, 35], [4, 10, 55], [10, 18, 75], [18, 99, 95]],
    "vol": [[-99, 0.8, 15], [0.8, 1.1, 35], [1.1, 1.5, 58], [1.5, 2.2, 78], [2.2, 99, 95]],
    "chase": [[-99, 0, 15], [0, 12, 35], [12, 28, 58], [28, 50, 78], [50, 999, 95]]
  },
  "levels": [[40, "舒适"], [60, "中性"], [75, "偏挤"], [85, "拥挤"], [101, "过热"]],
  "labels": {
    "ext": "均线延伸",
    "mom": "20日动量",
    "vol": "放量比",
    "chase": "60日追高"
  }
}
